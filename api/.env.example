# ─── Petermann API — modelo do .env ────────────────────────────────
# Copie para .env e preencha. O .env NUNCA vai para o Git nem para o zip.

APP_NAME="Petermann API"
APP_ENV=production
APP_KEY=                                   # php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.pmservicosagronomicos.com.br
APP_TIMEZONE=UTC
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

# Endereço da PWA (para onde o login Google e o link de senha voltam)
FRONT_URL=https://app.pmservicosagronomicos.com.br/rda-rdm-app
# Origens liberadas no CORS (vírgula)
CORS_ORIGINS=https://app.pmservicosagronomicos.com.br

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ─── Banco: SQLite, um arquivo em database/database.sqlite ───────────
# Fora do web root. Vai para a Locaweb dentro do petermann-banco.zip (só no
# primeiro envio) e é migrado AQUI, no PC, antes de subir. Para MySQL, troque
# DB_CONNECTION=mysql e informe DB_HOST/DB_DATABASE/DB_USERNAME/DB_PASSWORD.
DB_CONNECTION=sqlite

# ─── Anexos em disco (FORA do public_html). Só o caminho vai ao banco.
FOTOS_PATH=/home/storage/x/xx/xx/petermann/fotos
FOTO_URL_TTL=300
FOTO_MAX_KB=20480

# ─── E-mail (Resend) ────────────────────────────────────────────────
MAIL_MAILER=resend
MAIL_FROM_ADDRESS=app@pmservicosagronomicos.com.br
MAIL_FROM_NAME="Petermann App"
RESEND_API_KEY=
REPASSE_EMAIL_FROM="Petermann App <app@pmservicosagronomicos.com.br>"
REPASSE_EMAIL_TO=repasse@pmservicosagronomicos.com.br

# ─── Monitoramento do armazenamento (21/09/2026) ────────────────────
# Teto de ALERTA em MB. O plano Hospedagem II é ilimitado em disco (21/09/2026),
# então o valor é uma referência para pegar crescimento anormal (20 GB).
# 0 = sem teto: o app mostra só os números, sem %.
# Cron diário: 10 4 * * * /usr/bin/php84 .../artisan armazenamento:verificar
ARMAZENAMENTO_LIMITE_MB=20480
ARMAZENAMENTO_AVISO_PCT=80
ARMAZENAMENTO_CRITICO_PCT=90

# ─── Login com Google (projeto CLEITON-PM no Google Cloud) ──────────
# Cadastre em "URIs de redirecionamento autorizados":
#   https://api.pmservicosagronomicos.com.br/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Sem fila nem cache externos na hospedagem compartilhada ────────
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ─── Só para a migração (php artisan migrar:supabase) ───────────────
# Postgres do Supabase: Project Settings > Database > Connection string
SUPABASE_DB_URL=
# Project Settings > API > service_role (NUNCA a anon)
SUPABASE_URL=https://alkndoafntxzkpcgscvz.supabase.co
SUPABASE_SERVICE_KEY=
